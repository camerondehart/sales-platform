# Copy to .env.local for development. Never commit real values.

# --- Required ---
AUTH_SECRET=change-me-to-at-least-32-random-characters
ADMIN_PASSWORD=change-me

# --- Storage (omit locally to use data/*.json on disk) ---
# BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---
# RESEND_API_KEY=
# INQUIRY_FROM_EMAIL=hello@your-verified-domain.com
# INQUIRY_TO_EMAIL=staff@your-domain.com
# CUSTOMER_REPLY_TO=support@your-domain.com
# EXPORT_RECIPIENT_EMAIL=owner@your-domain.com
# RESEND_WEBHOOK_SECRET=

# --- Concierge (OpenAI-compatible gateway; leave unset to run without AI) ---
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# --- Crons (vercel.json) ---
# CRON_SECRET=

# --- Optional shipping labels ---
# SHIPPO_API_KEY=
# SHIPPO_FROM_NAME=
# SHIPPO_FROM_STREET=
# SHIPPO_FROM_CITY=
# SHIPPO_FROM_STATE=
# SHIPPO_FROM_ZIP=
# SHIPPO_FROM_COUNTRY=US
# SHIPPO_FROM_PHONE=
# SHIPPO_FROM_EMAIL=

# --- Concierge voice (optional): the Gateway's speech endpoint ---
# Default https://ai-gateway.vercel.sh/v4/ai — uses AI_GATEWAY_API_KEY, no extra key.
# AI_GATEWAY_SPEECH_URL=

# --- Store locator (optional) ---
# Address lookup for map pins. Default https://nominatim.openstreetmap.org (free, no key, cached).
# NOMINATIM_URL=
# Address suggestions while staff type a store's street. Default https://photon.komoot.io.
# PHOTON_URL=

# --- Venmo payment matching (optional) ---
# The email address the business's Venmo notifications are sent to; Venmo emails
# addressed anywhere else are quarantined.
# VENMO_ACCOUNT_EMAIL=

# --- Brand overrides (build-time; brand.config.ts is the default) ---
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# NEXT_PUBLIC_BRAND_NAME=
# NEXT_PUBLIC_BRAND_SHORT_NAME=
# NEXT_PUBLIC_BRAND_MEMBERS=
# NEXT_PUBLIC_BRAND_LEGAL_NAME=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_BRAND_TAGLINE=
# NEXT_PUBLIC_BRAND_CITY=
# NEXT_PUBLIC_BRAND_EMOJI=
# NEXT_PUBLIC_BRAND_TIMEZONE=America/Los_Angeles
# NEXT_PUBLIC_VENMO_HANDLE=
# NEXT_PUBLIC_ZELLE_CONTACT=
